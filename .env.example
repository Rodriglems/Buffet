# Aplicacao local (fora do Docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/buffet?schema=public"
SESSION_SECRET="troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres"
SEED_ADMIN_EMAIL="admin@buffet.local"
SEED_ADMIN_PASSWORD="troque-esta-senha-inicial"

# E-mail transacional e links de recuperacao de senha
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="senha-de-app-sem-espacos"
EMAIL_FROM="Mesly <seu-email@gmail.com>"
# Endereço público do sistema (em produção: https://seu-dominio), usado nos links dos e-mails
APP_URL="http://localhost:3000"

# true quando houver proxy na frente (Nginx, Cloudflare): o limite de tentativas usa o IP real
TRUST_PROXY=false

# Integração HTTP de WhatsApp (payload JSON: { "to": "...", "message": "..." })
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""

# Armazenamento de imagens no Cloudflare R2 (passo a passo em docs/cloudflare-r2.md)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# Portas publicadas pelo Docker Compose
APP_PORT=3000
POSTGRES_PORT=5432

# Banco criado pelo Docker Compose
POSTGRES_DB=buffet
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
