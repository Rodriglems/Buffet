generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RoleUsuario {
  ADMIN
  CLIENT

  @@map("role_usuario")
}

enum TipoPessoa {
  FISICA
  JURIDICA

  @@map("tipo_pessoa")
}

enum StatusLead {
  NOVO
  CONTATO_REALIZADO
  QUALIFICADO
  PROPOSTA
  CONVERTIDO
  PERDIDO

  @@map("status_lead")
}

enum StatusEvento {
  ORCAMENTO
  APROVADO
  PAGAMENTO
  CONFIRMADO
  CANCELADO
  FINALIZADO

  @@map("status_evento")
}

enum StatusOrcamento {
  RASCUNHO
  ENVIADO
  VISUALIZADO
  EM_NEGOCIACAO
  AGUARDANDO_APROVACAO
  APROVADO
  REJEITADO
  EXPIRADO
  CANCELADO

  @@map("status_orcamento")
}

enum TipoDescontoOrcamento {
  VALOR_FIXO
  PERCENTUAL

  @@map("tipo_desconto_orcamento")
}

enum StatusPagamento {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO

  @@map("status_pagamento")
}

enum TipoDocumento {
  CONTRATO
  COMPROVANTE
  DOCUMENTO_CLIENTE
  OUTRO

  @@map("tipo_documento")
}

model Empresa {
  id                 String   @id @default(uuid()) @db.Uuid
  linkOrcamentoToken String   @unique @default(uuid()) @map("link_orcamento_token") @db.Uuid
  razaoSocial        String   @map("razao_social")
  nomeFantasia       String   @map("nome_fantasia")
  cnpj               String   @unique @db.VarChar(14)
  email              String   @unique
  telefone           String?  @db.VarChar(20)
  whatsapp           String?  @db.VarChar(20)
  // Telefones exibidos no PDF, como a empresa quer escrever: "(11) 9 1234-5678 / 3333-0000".
  telefonesContato   String?  @map("telefones_contato")
  cep                String?  @db.VarChar(8)
  estado             String?  @db.Char(2)
  cidade             String?
  bairro             String?
  logradouro         String?
  numero             String?
  complemento        String?
  logoUrl            String?  @map("logo_url")
  logoOrcamentoUrl   String?  @map("logo_orcamento_url")
  corTema            String   @default("grafite") @map("cor_tema")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  usuarios           Usuario[]
  clientes           Cliente[]
  leads              Lead[]
  eventos            Evento[]
  servicos           Servico[]
  categoriasCardapio CategoriaCardapio[]
  orcamentos         Orcamento[]
  pagamentos         Pagamento[]
  custos             Custo[]
  documentos         Documento[]
  compromissos       Compromisso[]

  @@map("empresas")
}

model Usuario {
  id                     String                  @id @default(uuid()) @db.Uuid
  empresaId              String                  @map("empresa_id") @db.Uuid
  nome                   String
  email                  String
  senhaHash              String                  @map("senha_hash")
  role                   RoleUsuario
  permissoes             Json                    @default("{}") @db.JsonB
  sessaoVersao           Int                     @default(0) @map("sessao_versao")
  ativo                  Boolean                 @default(true)
  ultimoLogin            DateTime?               @map("ultimo_login") @db.Timestamptz(6)
  tentativasLogin        Int                     @default(0) @map("tentativas_login")
  bloqueadoAte           DateTime?               @map("bloqueado_ate") @db.Timestamptz(6)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa                Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cliente                Cliente?
  notificacoes           Notificacao[]
  documentos             Documento[]
  tokensRecuperacaoSenha TokenRecuperacaoSenha[]

  @@unique([empresaId, email])
  @@unique([empresaId, id])
  @@index([empresaId, ativo])
  @@map("usuarios")
}

model TokenRecuperacaoSenha {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiraEm  DateTime  @map("expira_em") @db.Timestamptz(6)
  usadoEm   DateTime? @map("usado_em") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, createdAt(sort: Desc)])
  @@index([expiraEm])
  @@map("tokens_recuperacao_senha")
}

model Cliente {
  id          String      @id @default(uuid()) @db.Uuid
  empresaId   String      @map("empresa_id") @db.Uuid
  usuarioId   String?     @unique @map("usuario_id") @db.Uuid
  nome        String
  tipoPessoa  TipoPessoa  @map("tipo_pessoa")
  cpfCnpj     String?     @map("cpf_cnpj") @db.VarChar(14)
  email       String?
  telefone    String?     @db.VarChar(20)
  whatsapp    String?     @db.VarChar(20)
  cep         String?     @db.VarChar(8)
  estado      String?     @db.Char(2)
  cidade      String?
  bairro      String?
  logradouro  String?
  numero      String?
  complemento String?
  observacoes String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa     Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuario     Usuario?    @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict)
  eventos     Evento[]
  documentos  Documento[]

  @@unique([empresaId, cpfCnpj])
  @@unique([empresaId, usuarioId])
  @@unique([empresaId, id])
  @@index([empresaId, nome])
  @@map("clientes")
}

model Lead {
  id                   String     @id @default(uuid()) @db.Uuid
  empresaId            String     @map("empresa_id") @db.Uuid
  nome                 String
  email                String?
  telefone             String?    @db.VarChar(20)
  whatsapp             String?    @db.VarChar(20)
  tipoEvento           String?    @map("tipo_evento")
  dataEvento           DateTime?  @map("data_evento") @db.Date
  quantidadeConvidados Int?       @map("quantidade_convidados")
  origem               String?
  observacoes          String?
  status               StatusLead @default(NOVO)
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa              Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([empresaId, status])
  @@map("leads")
}

model Evento {
  id                   String       @id @default(uuid()) @db.Uuid
  empresaId            String       @map("empresa_id") @db.Uuid
  clienteId            String       @map("cliente_id") @db.Uuid
  nome                 String
  tipo                 String
  formatoServico       String?      @map("formato_servico")
  servicosAdicionais   String[]     @default([]) @map("servicos_adicionais")
  dataEvento           DateTime     @map("data_evento") @db.Date
  horaInicio           DateTime?    @map("hora_inicio") @db.Time(0)
  horaFim              DateTime?    @map("hora_fim") @db.Time(0)
  quantidadeConvidados Int          @map("quantidade_convidados")
  localNome            String?      @map("local_nome")
  cep                  String?      @db.VarChar(8)
  estado               String?      @db.Char(2)
  cidade               String?
  bairro               String?
  logradouro           String?
  numero               String?
  complemento          String?
  status               StatusEvento @default(ORCAMENTO)
  observacoes          String?
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa              Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cliente              Cliente      @relation(fields: [empresaId, clienteId], references: [empresaId, id], onDelete: Restrict)
  orcamentos           Orcamento[]
  pagamentos           Pagamento[]
  custos               Custo[]
  documentos           Documento[]

  @@unique([empresaId, id])
  @@index([empresaId, dataEvento])
  @@index([clienteId])
  @@map("eventos")
}

model Servico {
  id             String          @id @default(uuid()) @db.Uuid
  empresaId      String          @map("empresa_id") @db.Uuid
  nome           String
  categoria      String          @default("Geral")
  tiposEvento    String[]        @default([]) @map("tipos_evento")
  cardapios      String[]        @default([])
  descricao      String?
  imagemUrl      String?         @map("imagem_url")
  unidade        String
  precoBase      Decimal         @map("preco_base") @db.Decimal(14, 2)
  precoVisivel   Boolean         @default(true) @map("preco_visivel")
  ordem          Int             @default(0)
  sugestaoChef   Boolean         @default(false) @map("sugestao_chef")
  // Nome da escolha pedida ao cliente quando o item tem opções (ex.: "Recheio").
  opcoesRotulo   String?         @map("opcoes_rotulo")
  ativo          Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa        Empresa         @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  orcamentoItens OrcamentoItem[]
  opcoes         ServicoOpcao[]  @relation("ServicoComOpcoes")
  opcaoDe        ServicoOpcao[]  @relation("OpcaoDoServico")

  @@unique([empresaId, nome])
  @@unique([empresaId, id])
  @@index([empresaId, sugestaoChef, ativo, ordem])
  @@map("servicos")
}

/// Categorias do cardápio, editáveis pela empresa. Servico.categoria guarda o nome.
model CategoriaCardapio {
  id        String   @id @default(uuid()) @db.Uuid
  empresaId String   @map("empresa_id") @db.Uuid
  nome      String
  ordem     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@unique([empresaId, nome])
  @@index([empresaId, ordem])
  @@map("categorias_cardapio")
}

/// Opções que o cliente escolhe para um item (ex.: os recheios possíveis de cada massa).
model ServicoOpcao {
  servicoId String  @map("servico_id") @db.Uuid
  opcaoId   String  @map("opcao_id") @db.Uuid
  servico   Servico @relation("ServicoComOpcoes", fields: [servicoId], references: [id], onDelete: Cascade)
  opcao     Servico @relation("OpcaoDoServico", fields: [opcaoId], references: [id], onDelete: Cascade)

  @@id([servicoId, opcaoId])
  @@index([opcaoId])
  @@map("servico_opcoes")
}

model Orcamento {
  id            String                @id @default(uuid()) @db.Uuid
  empresaId     String                @map("empresa_id") @db.Uuid
  eventoId      String                @map("evento_id") @db.Uuid
  numero        BigInt
  versao        Int                   @default(1)
  status        StatusOrcamento       @default(RASCUNHO)
  validade      DateTime?             @db.Date
  subtotal      Decimal               @default(0) @db.Decimal(14, 2)
  tipoDesconto  TipoDescontoOrcamento @default(VALOR_FIXO) @map("tipo_desconto")
  descontoValor Decimal               @default(0) @map("desconto_valor") @db.Decimal(14, 2)
  desconto      Decimal               @default(0) @db.Decimal(14, 2)
  total         Decimal               @default(0) @db.Decimal(14, 2)
  observacoes   String?
  /// Quando a equipe enviou o orçamento ao cliente; antes disso o cliente não vê valores.
  enviadoEm     DateTime?             @map("enviado_em") @db.Timestamptz(6)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa       Empresa               @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  evento        Evento                @relation(fields: [empresaId, eventoId], references: [empresaId, id], onDelete: Restrict)
  itens         OrcamentoItem[]

  @@unique([empresaId, numero, versao])
  @@unique([empresaId, id])
  @@unique([empresaId, eventoId, id])
  @@index([eventoId, versao(sort: Desc)])
  @@map("orcamentos")
}

model OrcamentoItem {
  id            String    @id @default(uuid()) @db.Uuid
  orcamentoId   String    @map("orcamento_id") @db.Uuid
  servicoId     String?   @map("servico_id") @db.Uuid
  descricao     String
  quantidade    Decimal   @db.Decimal(12, 3)
  unidade       String
  valorUnitario Decimal   @map("valor_unitario") @db.Decimal(14, 2)
  desconto      Decimal   @default(0) @db.Decimal(14, 2)
  valorTotal    Decimal   @map("valor_total") @db.Decimal(14, 2)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  orcamento     Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  servico       Servico?  @relation(fields: [servicoId], references: [id], onDelete: SetNull)

  @@index([orcamentoId])
  @@map("orcamento_itens")
}

model Pagamento {
  id             String          @id @default(uuid()) @db.Uuid
  empresaId      String          @map("empresa_id") @db.Uuid
  eventoId       String          @map("evento_id") @db.Uuid
  numeroParcela  Int             @map("numero_parcela")
  descricao      String?
  valor          Decimal         @db.Decimal(14, 2)
  dataVencimento DateTime        @map("data_vencimento") @db.Date
  dataPagamento  DateTime?       @map("data_pagamento") @db.Date
  status         StatusPagamento @default(PENDENTE)
  formaPagamento String?         @map("forma_pagamento")
  observacoes    String?
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa        Empresa         @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  evento         Evento          @relation(fields: [empresaId, eventoId], references: [empresaId, id], onDelete: Restrict)

  @@unique([eventoId, numeroParcela])
  @@index([empresaId, dataVencimento, status])
  @@map("pagamentos")
}

model Custo {
  id          String   @id @default(uuid()) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  eventoId    String   @map("evento_id") @db.Uuid
  categoria   String
  descricao   String
  fornecedor  String?
  valor       Decimal  @db.Decimal(14, 2)
  data        DateTime @db.Date
  observacoes String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  evento      Evento   @relation(fields: [empresaId, eventoId], references: [empresaId, id], onDelete: Restrict)

  @@index([eventoId, data])
  @@map("custos")
}

model Notificacao {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  tipo      String
  titulo    String
  mensagem  String
  lida      Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lidaEm    DateTime? @map("lida_em") @db.Timestamptz(6)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, lida, createdAt(sort: Desc)])
  @@map("notificacoes")
}

model Documento {
  id        String        @id @default(uuid()) @db.Uuid
  empresaId String        @map("empresa_id") @db.Uuid
  usuarioId String?       @map("usuario_id") @db.Uuid
  clienteId String?       @map("cliente_id") @db.Uuid
  eventoId  String?       @map("evento_id") @db.Uuid
  nome      String
  tipo      TipoDocumento
  url       String
  tamanho   BigInt?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa   Empresa       @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuario   Usuario?      @relation(fields: [empresaId, usuarioId], references: [empresaId, id], onDelete: Restrict)
  cliente   Cliente?      @relation(fields: [empresaId, clienteId], references: [empresaId, id], onDelete: Restrict)
  evento    Evento?       @relation(fields: [empresaId, eventoId], references: [empresaId, id], onDelete: Restrict)

  @@index([empresaId, createdAt(sort: Desc)])
  @@map("documentos")
}

/// Compromisso livre da agenda (ex.: "Pagar boleto da fornecedora").
model Compromisso {
  id          String   @id @default(uuid()) @db.Uuid
  empresaId   String   @map("empresa_id") @db.Uuid
  titulo      String
  data        DateTime @db.Date
  /// Horário opcional no formato HH:MM.
  hora        String?
  observacoes String?
  concluido   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([empresaId, data])
  @@map("compromissos")
}
